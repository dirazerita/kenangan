<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navy splash background matching KenangPalette.backgroundBottom, so the
         window never flashes white before Compose draws. -->
    <style name="Theme.Kenang" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kenang_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
