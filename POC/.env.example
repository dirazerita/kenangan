# Copy to project root as .env — never commit real keys
FAL_KEY=your-fal-key-id:your-fal-key-secret
# optional backup fal keys (AD-14 failover order: FAL_KEY -> FAL_KEY_2 -> FAL_KEY_3);
# only keys you legitimately own — farming fal signup credits violates fal ToS
FAL_KEY_2=
FAL_KEY_3=
GOOGLE_API_KEY=your-google-ai-studio-key
ELEVENLABS_API_KEY=your-elevenlabs-key
